{
  "manifest_version": 3,
  "name": "쿠팡 판매자정보 캡처",
  "version": "1.14.0",
  "description": "쿠팡 상품페이지의 판매자 정보를 캡처하여 CSV로 누적 저장하고, 구글 스프레드시트로 실시간 동기화하며, 협업 제안 메일 작성/페이스 조절 발송과 네이버 스토어 리뷰 수집을 돕습니다.",
  "permissions": ["storage", "activeTab", "scripting", "downloads", "tabs", "alarms"],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://mail.google.com/*",
    "https://brand.naver.com/*",
    "https://smartstore.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "판매자정보 캡처"
  },
  "commands": {
    "capture-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "현재 쿠팡 상품페이지의 판매자정보 즉시 캡처"
    }
  }
}
